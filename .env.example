# Copy to .env and fill in as needed. Nothing here is required to run the stack locally
# with default values except where noted.

# --- Postgres (bronze/silver/gold) ---
POSTGRES_USER=cmip
POSTGRES_PASSWORD=cmip123
POSTGRES_DB=cmip
POSTGRES_HOST=localhost      # use "postgres" when running inside docker compose
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cmip:cmip123@localhost:5432/cmip

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=clinical_notes

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=cmip_rag_pipeline

# --- Ollama (runs natively on host, not in docker compose) ---
OLLAMA_BASE_URL=http://localhost:11434   # use http://host.docker.internal:11434 from containers
OLLAMA_MODEL_DEFAULT=llama3
OLLAMA_MODEL_FAST=mistral

# --- MCP server ---
MCP_HOST=127.0.0.1
MCP_PORT=8100
MCP_SERVER_URL=http://127.0.0.1:8100/mcp

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- LangSmith tracing: OFF BY DEFAULT. Only set these if you have your own LangSmith
# account and want tracing — nothing is sent anywhere unless BOTH vars below are set. ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=cmip
